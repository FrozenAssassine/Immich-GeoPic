# URL to your Immich instance (including protocol, host, and port if custom)
# Examples: http://immich-server:2283, https://photos.mydomain.com
IMMICH_URL=http://immich-server:2283

# (Optional) Immich API Key.
# If provided, no login is required (ideal for private network / home server setups).
# If left empty, users must log in on the UI with their Immich email and password.
IMMICH_API_KEY=

# (Optional) Data directory for application settings and custom base-maps
# Defaults to ./data locally, or /app/data in Docker
# GEOPIC_DATA_DIR=/app/data

